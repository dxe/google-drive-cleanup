{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Review API (Go)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}",
      "args": ["review"],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Review UI (Next.js)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/web",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "- Local:.+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ],
  "compounds": [
    {
      "name": "Review (API + UI)",
      "configurations": ["Review API (Go)", "Review UI (Next.js)"],
      "stopAll": true
    }
  ]
}
