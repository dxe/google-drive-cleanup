{
    "name": "google-drive-cleanup",
    "image": "mcr.microsoft.com/devcontainers/base:trixie",
    "features": {
        "ghcr.io/devcontainers/features/go:1": {
            "version": "1.26.4"
        },
        "ghcr.io/rocker-org/devcontainer-features/apt-packages:1": {
            // bash-completion is useful for entering git commands in the devcontainer
            //     and our .bashrc requires this.
            "packages": "bash-completion"
        }
    },
    "postCreateCommand": "bash /workspaces/google-drive-cleanup/.devcontainer/post-create.sh",
    "forwardPorts": [
        8765
    ],
    "portsAttributes": {
        "8765": {
            "label": "oauth-callback",
            "onAutoForward": "silent"
        }
    }
}